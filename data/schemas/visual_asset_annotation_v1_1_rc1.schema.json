{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenemind-x.local/schemas/visual-asset-annotation-v1-1-rc1.schema.json",
  "title": "SceneMind-X shared visual facts RC1",
  "description": "Machine contract for p3_shared_fact_v1_4_rc1. It contains exactly the twelve model-generated shared-fact fields and no downstream task records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visual_medium",
    "depicted_content",
    "scene_summary",
    "subjects",
    "activities",
    "relationships",
    "text_assessment",
    "evidence_items",
    "claims",
    "short_caption",
    "dense_caption",
    "self_check"
  ],
  "properties": {
    "visual_medium": {"$ref": "#/$defs/visual_medium"},
    "depicted_content": {"$ref": "#/$defs/depicted_content"},
    "scene_summary": {"$ref": "#/$defs/nullable_summary"},
    "subjects": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/subject"}},
    "activities": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/activity"}},
    "relationships": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/relationship"}},
    "text_assessment": {"$ref": "#/$defs/text_assessment"},
    "evidence_items": {"type": "array", "maxItems": 60, "items": {"$ref": "#/$defs/evidence_item"}},
    "claims": {"type": "array", "maxItems": 60, "items": {"$ref": "#/$defs/claim"}},
    "short_caption": {"$ref": "#/$defs/nullable_short_caption"},
    "dense_caption": {"$ref": "#/$defs/nullable_dense_caption"},
    "self_check": {"$ref": "#/$defs/self_check"}
  },
  "$defs": {
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "nullable_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "nullable_summary": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
    "nullable_short_caption": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "nullable_dense_caption": {"type": ["string", "null"], "minLength": 1, "maxLength": 600},
    "medium_type": {
      "enum": [
        "real_world_photo",
        "screenshot",
        "presentation_slide",
        "meme_or_reaction_image",
        "poster_or_advertisement",
        "document_or_paper",
        "webpage_or_user_interface",
        "chat_screenshot",
        "chart_or_infographic",
        "illustration_or_comic",
        "packaging",
        "mixed",
        "uncertain"
      ]
    },
    "evidence_ref": {"type": "string", "pattern": "^ev[1-9][0-9]*$"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_ref"}
    },
    "evidence_refs_optional": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_ref"}
    },
    "visual_medium": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_type", "secondary_types", "confidence", "evidence_refs", "uncertainty_reason"],
      "properties": {
        "primary_type": {"$ref": "#/$defs/medium_type"},
        "secondary_types": {"type": "array", "maxItems": 13, "uniqueItems": true, "items": {"$ref": "#/$defs/medium_type"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs_optional"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_reason"}
      },
      "allOf": [
        {
          "if": {"properties": {"primary_type": {"const": "uncertain"}}, "required": ["primary_type"]},
          "then": {"properties": {"uncertainty_reason": {"type": "string", "minLength": 1, "maxLength": 160}}}
        }
      ]
    },
    "depicted_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "real_world_event_status", "evidence_refs", "uncertainty_reason"],
      "properties": {
        "summary": {"$ref": "#/$defs/nullable_summary"},
        "real_world_event_status": {"enum": ["directly_observed", "depicted_only", "mixed", "uncertain"]},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs_optional"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_reason"}
      },
      "allOf": [
        {
          "if": {"properties": {"real_world_event_status": {"const": "uncertain"}}, "required": ["real_world_event_status"]},
          "then": {"properties": {"uncertainty_reason": {"type": "string", "minLength": 1, "maxLength": 160}}}
        }
      ]
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 60},
        "value": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "name", "salience", "medium_layer", "attributes", "evidence_refs", "confidence", "uncertainty_reason"],
      "properties": {
        "subject_id": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "salience": {"enum": ["primary", "secondary", "background", "uncertain"]},
        "medium_layer": {"enum": ["scene_direct", "depicted_inside_medium", "both", "uncertain"]},
        "attributes": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/attribute"}},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_reason"}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "action", "evidence_refs", "confidence", "uncertainty_reason"],
      "properties": {
        "subject_ref": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
        "action": {"type": "string", "minLength": 1, "maxLength": 80},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_reason"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "relation", "object_ref", "object_text", "evidence_refs", "confidence", "uncertainty_reason"],
      "properties": {
        "subject_ref": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
        "relation": {"type": "string", "minLength": 1, "maxLength": 80},
        "object_ref": {"type": ["string", "null"], "pattern": "^s[1-9][0-9]*$"},
        "object_text": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_reason"}
      },
      "oneOf": [
        {"properties": {"object_ref": {"type": "string"}, "object_text": {"type": "null"}}},
        {"properties": {"object_ref": {"type": "null"}, "object_text": {"type": "string", "minLength": 1, "maxLength": 80}}}
      ]
    },
    "ocr_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language", "script_type", "legibility", "direction", "source_type", "region_ref", "confidence", "uncertainty_reason"],
      "properties": {
        "text": {"type": ["string", "null"], "minLength": 1, "maxLength": 240},
        "language": {"type": ["string", "null"], "minLength": 1, "maxLength": 40},
        "script_type": {"enum": ["printed", "handwritten", "artistic", "digital", "mixed", "unknown"]},
        "legibility": {"enum": ["none", "low", "partial", "high", "mixed"]},
        "direction": {"enum": ["left_to_right", "right_to_left", "top_to_bottom", "mixed", "unknown"]},
        "source_type": {"enum": ["model_visual", "ocr_tool", "human_gold"]},
        "region_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_reason"}
      }
    },
    "text_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_presence", "text_types", "legibility", "suspected_false_positive", "false_positive_contexts", "ocr_candidates", "scene_inference_allowed", "uncertainty_reason"],
      "properties": {
        "text_presence": {"enum": ["none", "possible", "present"]},
        "text_types": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"enum": ["printed", "handwritten", "artistic", "digital_interface", "mixed", "unknown"]}},
        "legibility": {"enum": ["none", "low", "partial", "high", "mixed"]},
        "suspected_false_positive": {"type": "boolean"},
        "false_positive_contexts": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"enum": ["footprint", "snow", "texture", "glare", "reflection", "compression_artifact", "other"]}},
        "ocr_candidates": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/ocr_candidate"}},
        "scene_inference_allowed": {"type": "boolean"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_reason"}
      },
      "allOf": [
        {
          "if": {"properties": {"text_presence": {"const": "none"}}, "required": ["text_presence"]},
          "then": {"properties": {"text_types": {"maxItems": 0}, "legibility": {"const": "none"}, "ocr_candidates": {"maxItems": 0}, "scene_inference_allowed": {"const": false}}}
        },
        {
          "if": {"properties": {"text_presence": {"const": "possible"}}, "required": ["text_presence"]},
          "then": {"properties": {"scene_inference_allowed": {"const": false}, "uncertainty_reason": {"type": "string", "minLength": 1, "maxLength": 160}}}
        },
        {
          "if": {"properties": {"suspected_false_positive": {"const": true}}, "required": ["suspected_false_positive"]},
          "then": {"properties": {"false_positive_contexts": {"minItems": 1}}}
        }
      ]
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_type", "content", "region_ref", "tool_ref", "confidence"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^ev[1-9][0-9]*$"},
        "source_type": {"enum": ["visual_global", "visual_region", "model_text_assessment", "ocr_tool", "grounding_tool", "sam_tool", "human_gold"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 240},
        "region_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
        "tool_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "text", "evidence_refs", "confidence", "uncertainty_reason"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^cl[1-9][0-9]*$"},
        "claim_type": {"enum": ["direct_observation", "reasonable_inference", "uncertain", "abstention"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 240},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_reason"}
      },
      "allOf": [
        {
          "if": {"properties": {"claim_type": {"enum": ["uncertain", "abstention"]}}, "required": ["claim_type"]},
          "then": {"properties": {"uncertainty_reason": {"type": "string", "minLength": 1, "maxLength": 160}}}
        }
      ]
    },
    "self_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["medium_content_separated", "ocr_false_positive_guard_passed", "unsupported_inference_absent", "json_complete", "issues"],
      "properties": {
        "medium_content_separated": {"type": "boolean"},
        "ocr_false_positive_guard_passed": {"type": "boolean"},
        "unsupported_inference_absent": {"type": "boolean"},
        "json_complete": {"type": "boolean"},
        "issues": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}}
      }
    }
  }
}
