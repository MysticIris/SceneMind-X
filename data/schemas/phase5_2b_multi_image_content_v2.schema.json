{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenemind-x.local/schemas/phase5_2b_multi_image_content_v2.schema.json",
  "title": "SceneMind-X multi-image content V2 model output",
  "type": "object",
  "required": ["final_text", "used_images", "evidence", "uncertainty"],
  "properties": {
    "final_text": {
      "type": "string",
      "minLength": 1
    },
    "used_images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["image_position", "basis"],
        "properties": {
          "image_position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  },
  "additionalProperties": false
}
