{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenemind-x.local/schemas/visual_asset_annotation_v1_1_rc2.schema.json",
  "title": "SceneMind-X RC2 compact shared visual facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visual_medium",
    "depicted_content",
    "scene_summary",
    "subjects",
    "activities",
    "relationships",
    "text_assessment",
    "evidence_items",
    "claims"
  ],
  "properties": {
    "visual_medium": {"$ref": "#/$defs/visual_medium"},
    "depicted_content": {"$ref": "#/$defs/depicted_content"},
    "scene_summary": {"$ref": "#/$defs/nullable_summary"},
    "subjects": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/subject"}},
    "activities": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/activity"}},
    "relationships": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/relationship"}},
    "text_assessment": {"$ref": "#/$defs/text_assessment"},
    "evidence_items": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/evidence_item"}},
    "claims": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "nullable_uncertainty": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 80},
        {"type": "null"}
      ]
    },
    "nullable_summary": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 80},
        {"type": "null"}
      ]
    },
    "evidence_ref": {"type": "string", "pattern": "^ev[1-9][0-9]*$"},
    "subject_ref": {"type": "string", "pattern": "^s[1-9][0-9]*$"},
    "medium_type": {
      "type": "string",
      "enum": [
        "real_world_photo",
        "screenshot",
        "presentation_slide",
        "meme_or_reaction_image",
        "poster_or_advertisement",
        "document_or_paper",
        "webpage_or_user_interface",
        "chat_screenshot",
        "chart_or_infographic",
        "illustration_or_comic",
        "packaging",
        "photographed_screen_content",
        "mixed",
        "uncertain"
      ]
    },
    "visual_medium": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_type", "secondary_types", "evidence_refs", "confidence", "uncertainty_reason"],
      "properties": {
        "primary_type": {"$ref": "#/$defs/medium_type"},
        "secondary_types": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/medium_type"}},
        "evidence_refs": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_uncertainty"}
      }
    },
    "depicted_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "real_world_event_status", "evidence_refs", "uncertainty_reason"],
      "properties": {
        "summary": {"$ref": "#/$defs/nullable_summary"},
        "real_world_event_status": {"type": "string", "enum": ["directly_observed", "depicted_only", "mixed", "uncertain", "unknown"]},
        "evidence_refs": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_uncertainty"}
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 24},
        "value": {"type": "string", "minLength": 1, "maxLength": 48}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "name", "salience", "medium_layer", "attributes", "evidence_refs", "confidence", "uncertainty_reason"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/subject_ref"},
        "name": {"type": "string", "minLength": 1, "maxLength": 32},
        "salience": {"type": "string", "enum": ["primary", "secondary", "background", "uncertain"]},
        "medium_layer": {"type": "string", "enum": ["scene_direct", "depicted_inside_medium", "both", "uncertain"]},
        "attributes": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/attribute"}},
        "evidence_refs": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_uncertainty"}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "action", "evidence_refs", "confidence", "uncertainty_reason"],
      "properties": {
        "subject_ref": {"$ref": "#/$defs/subject_ref"},
        "action": {"type": "string", "minLength": 1, "maxLength": 40},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_uncertainty"}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "relation", "object_ref", "object_text", "evidence_refs", "confidence", "uncertainty_reason"],
      "properties": {
        "subject_ref": {"$ref": "#/$defs/subject_ref"},
        "relation": {"type": "string", "minLength": 1, "maxLength": 24},
        "object_ref": {"anyOf": [{"$ref": "#/$defs/subject_ref"}, {"type": "null"}]},
        "object_text": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 40}, {"type": "null"}]},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_uncertainty"}
      },
      "oneOf": [
        {"properties": {"object_ref": {"$ref": "#/$defs/subject_ref"}, "object_text": {"type": "null"}}},
        {"properties": {"object_ref": {"type": "null"}, "object_text": {"type": "string", "minLength": 1, "maxLength": 40}}}
      ]
    },
    "selected_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language", "script_type", "legibility", "direction", "region_ref", "confidence", "uncertainty_reason"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 48},
        "language": {"type": "string", "pattern": "^(?:[a-z]{2,3}(?:-[A-Za-z0-9]+)?|unknown)$"},
        "script_type": {"type": "string", "enum": ["printed", "handwritten", "artistic", "digital", "mixed", "unknown"]},
        "legibility": {"type": "string", "enum": ["none", "low", "partial", "high", "mixed"]},
        "direction": {"type": "string", "enum": ["left_to_right", "right_to_left", "top_to_bottom", "mixed", "unknown"]},
        "region_ref": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 64}, {"type": "null"}]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_uncertainty"}
      }
    },
    "text_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_presence", "legibility", "suspected_false_positive", "false_positive_contexts", "selected_text", "scene_inference_allowed", "uncertainty_reason"],
      "properties": {
        "text_presence": {"type": "string", "enum": ["none", "possible", "present"]},
        "legibility": {"type": "string", "enum": ["none", "low", "partial", "high", "mixed"]},
        "suspected_false_positive": {"type": "boolean"},
        "false_positive_contexts": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["footprint", "snow", "texture", "glare", "reflection", "compression_artifact", "other"]}},
        "selected_text": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/selected_text"}},
        "scene_inference_allowed": {"type": "boolean"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_uncertainty"}
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "source_type", "content", "region_ref", "tool_ref", "confidence"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/evidence_ref"},
        "source_type": {"type": "string", "enum": ["visual_global", "visual_region", "model_text_assessment"]},
        "content": {"type": "string", "minLength": 1, "maxLength": 48},
        "region_ref": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 64}, {"type": "null"}]},
        "tool_ref": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_type", "text", "evidence_refs", "confidence", "uncertainty_reason"],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^cl[1-9][0-9]*$"},
        "claim_type": {"type": "string", "enum": ["direct_observation", "reasonable_inference", "uncertain", "abstention"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 64},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_ref"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "uncertainty_reason": {"$ref": "#/$defs/nullable_uncertainty"}
      }
    }
  }
}
