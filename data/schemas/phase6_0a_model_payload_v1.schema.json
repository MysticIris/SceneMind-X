{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenemind-x.local/schemas/phase6_0a_model_payload_v1.schema.json",
  "title": "SceneMind-X Phase 6.0-A model semantic payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload_version", "display", "facts", "evidence", "text_evidence", "fallback"],
  "properties": {
    "payload_version": {"const": "phase6_0a_model_payload_v1"},
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "short_description", "micro_tags"],
      "properties": {
        "theme": {"type": "string", "minLength": 2, "maxLength": 24},
        "short_description": {"type": "string", "minLength": 12, "maxLength": 140},
        "micro_tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 18}
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_medium", "scene", "subjects", "actions", "attributes", "relations"],
      "properties": {
        "visual_medium": {
          "enum": ["photograph", "screenshot", "illustration", "poster_document", "product_packaging", "mixed", "uncertain"]
        },
        "scene": {"type": "string", "maxLength": 100},
        "subjects": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
        "actions": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
        "attributes": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
        "relations": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 60}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_observations", "cautious_inferences", "uncertainties"],
      "properties": {
        "direct_observations": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "cautious_inferences": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "uncertainties": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
      }
    },
    "text_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence", "visual_candidates"],
      "properties": {
        "presence": {"enum": ["none", "present_readable", "present_unreadable", "uncertain"]},
        "visual_candidates": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 40}}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_caption", "safe_facts"],
      "properties": {
        "safe_caption": {"type": "string", "minLength": 8, "maxLength": 140},
        "safe_facts": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
      }
    }
  }
}
