{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenemind-x.local/schemas/semantic-payload-v1.schema.json",
  "title": "SceneMind-X semantic payload v1",
  "description": "Small model-facing payload. It is not the final annotation contract and contains no generated IDs or defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["global_observation", "subjects", "activities", "relations", "visible_text_candidates", "scene_hypotheses", "uncertainties", "evidence_descriptions"],
  "properties": {
    "global_observation": {"type": "object", "additionalProperties": false, "required": ["concise_caption", "detailed_caption", "scene_type", "environment", "visual_style", "image_quality"], "properties": {
      "concise_caption": {"type": "string", "minLength": 1}, "detailed_caption": {"type": "string", "minLength": 1},
      "scene_type": {"type": ["string", "null"]}, "environment": {"type": ["string", "null"]}, "visual_style": {"type": ["string", "null"]},
      "image_quality": {"type": "object", "additionalProperties": false, "required": ["overall", "issues"], "properties": {"overall": {"enum": ["high", "medium", "low", "unknown"]}, "issues": {"type": "array", "items": {"type": "string"}}}}
    }},
    "subjects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["category", "attributes", "approximate_count", "position", "salience", "confidence", "visual_presence_type", "presence_confidence", "presence_evidence_refs"], "properties": {
      "category": {"type": "string", "minLength": 1}, "attributes": {"type": "object"}, "approximate_count": {"type": ["integer", "null"], "minimum": 0},
      "position": {"type": ["object", "null"]}, "salience": {"enum": ["high", "medium", "low", "unknown"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "visual_presence_type": {"enum": ["direct_object", "reflection", "shadow", "motion_ghost", "screen_content", "printed_image", "uncertain"]},
      "presence_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "alternative_presence_types": {"type": "array"}, "presence_evidence_refs": {"type": "array", "items": {"type": "string"}}
    }}},
    "activities": {"type": "array", "items": {"type": "string"}},
    "relations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["subject_index", "predicate", "object_index", "spatial_relation", "confidence", "evidence_refs"], "properties": {
      "subject_index": {"type": "integer", "minimum": 0}, "predicate": {"type": "string", "minLength": 1}, "object_index": {"type": "integer", "minimum": 0}, "spatial_relation": {"type": ["string", "null"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}
    }}},
    "visible_text_candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["language", "script_type", "legibility", "ocr_candidates", "selected_text", "confidence", "used_for_scene_inference", "uncertainty_reason", "evidence_region"], "properties": {
      "language": {"type": ["string", "null"]}, "script_type": {"enum": ["printed", "handwritten", "artistic", "mixed", "unknown"]}, "legibility": {"enum": ["high", "medium", "low", "unreadable"]}, "ocr_candidates": {"type": "array", "items": {"type": "string"}}, "selected_text": {"type": ["string", "null"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "used_for_scene_inference": {"type": "boolean"}, "uncertainty_reason": {"type": ["string", "null"]}, "evidence_region": {"type": ["object", "null"]}
    }}},
    "scene_hypotheses": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "confidence", "evidence_refs", "supporting_modalities", "uncertainty_reason"], "properties": {
      "label": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "supporting_modalities": {"type": "array", "items": {"type": "string"}}, "uncertainty_reason": {"type": ["string", "null"]}
    }}},
    "uncertainties": {"type": "object", "additionalProperties": false, "required": ["uncertain_claims", "ambiguity", "missing_information", "abstention_reason"], "properties": {
      "uncertain_claims": {"type": "array", "items": {"type": "string"}}, "ambiguity": {"type": "array", "items": {"type": "string"}}, "missing_information": {"type": "array", "items": {"type": "string"}}, "abstention_reason": {"type": ["string", "null"]}
    }},
    "evidence_descriptions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim", "claim_type", "confidence", "evidence_refs"], "properties": {
      "claim": {"type": "string", "minLength": 1}, "claim_type": {"enum": ["directly_observed", "reasonable_inference", "external_common_knowledge", "uncertain"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}
    }}}
  }
}
