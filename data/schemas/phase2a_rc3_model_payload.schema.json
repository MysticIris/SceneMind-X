{
  "$defs": {
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Legibility": {
      "enum": [
        "none",
        "low",
        "partial",
        "high",
        "mixed"
      ],
      "title": "Legibility",
      "type": "string"
    },
    "Rc3Inference": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "support": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Support",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "text",
        "support",
        "confidence"
      ],
      "title": "Rc3Inference",
      "type": "object"
    },
    "Rc3TextAssessment": {
      "additionalProperties": false,
      "properties": {
        "presence": {
          "$ref": "#/$defs/TextPresence"
        },
        "legibility": {
          "$ref": "#/$defs/Legibility"
        },
        "selected_text": {
          "anyOf": [
            {
              "items": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Text"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary"
        },
        "uncertainty": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncertainty"
        }
      },
      "required": [
        "presence",
        "legibility",
        "selected_text",
        "summary",
        "uncertainty"
      ],
      "title": "Rc3TextAssessment",
      "type": "object"
    },
    "TextPresence": {
      "enum": [
        "none",
        "possible",
        "present"
      ],
      "title": "TextPresence",
      "type": "string"
    },
    "VisualMedium": {
      "enum": [
        "real_world_photo",
        "screenshot",
        "presentation_slide",
        "meme_or_reaction_image",
        "poster_or_advertisement",
        "document_or_paper",
        "webpage_or_user_interface",
        "chat_screenshot",
        "chart_or_infographic",
        "illustration_or_comic",
        "packaging",
        "photographed_screen_content",
        "mixed",
        "uncertain"
      ],
      "title": "VisualMedium",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "visual_medium": {
      "$ref": "#/$defs/VisualMedium"
    },
    "depicted_content": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Depicted Content"
    },
    "scene_summary": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scene Summary"
    },
    "subjects": {
      "items": {
        "maxLength": 48,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 6,
      "title": "Subjects",
      "type": "array"
    },
    "activities": {
      "items": {
        "maxLength": 48,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "title": "Activities",
      "type": "array"
    },
    "relationships": {
      "items": {
        "maxLength": 48,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "title": "Relationships",
      "type": "array"
    },
    "text_assessment": {
      "$ref": "#/$defs/Rc3TextAssessment"
    },
    "observations": {
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "inferences": {
      "items": {
        "$ref": "#/$defs/Rc3Inference"
      },
      "maxItems": 4,
      "title": "Inferences",
      "type": "array"
    }
  },
  "required": [
    "visual_medium",
    "depicted_content",
    "scene_summary",
    "subjects",
    "activities",
    "relationships",
    "text_assessment",
    "observations",
    "inferences"
  ],
  "title": "Rc3ModelPayload",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2a_rc3_model_payload_v1"
}
