{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenemind-x.local/schemas/gate1-d3-semantic-review-payload-v1-4.schema.json",
  "title": "Gate 1-D3 fixed-string semantic review payload v1.4",
  "description": "Nine fixed short strings used to avoid array-format truncation while preserving the semantic review dimensions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["global_observation", "subjects", "activities", "attributes", "relations", "visible_text_candidates", "scene_hypotheses", "uncertainties", "evidence_descriptions"],
  "properties": {
    "global_observation": {"type": "string", "maxLength": 80},
    "subjects": {"type": "string", "maxLength": 80},
    "activities": {"type": "string", "maxLength": 80},
    "attributes": {"type": "string", "maxLength": 80},
    "relations": {"type": "string", "maxLength": 80},
    "visible_text_candidates": {"type": "string", "maxLength": 80},
    "scene_hypotheses": {"type": "string", "maxLength": 80},
    "uncertainties": {"type": "string", "maxLength": 80},
    "evidence_descriptions": {"type": "string", "maxLength": 80}
  }
}
